---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
---
<Base
  title="Hydrosyng Oil & Gas Ltd — Reliable Energy for Nigeria"
  description="Hydrosyng Oil & Gas Ltd (RC 1232655) is an indigenous Nigerian energy company supplying petroleum products, gas & LPG, haulage and integrated engineering & energy services nationwide."
  current="home"
  path="/"
>
  <!-- HERO SLIDER -->
  <section class="hero-slider" aria-label="Featured highlights" aria-roledescription="carousel">
    <div class="hs-track">
      <div class="hs-slide is-active">
        <div class="hs-bg"><img src="/img/hero-refinery.jpg" alt="" fetchpriority="high" /></div>
        <div class="container">
          <div class="hs-inner">
            <span class="hs-kicker">Reliable Energy Supply</span>
            <h1>Powering Progress Through Reliable Energy</h1>
            <p class="lead">Hydrosyng Oil &amp; Gas Ltd supplies dependable petroleum products, gas &amp; LPG and energy services to homes, businesses and industry across Nigeria.</p>
            <div class="btn-row">
              <a href="/services" class="btn btn-primary btn-lg">Explore Our Services <Icon name="arrow" /></a>
              <a href="/about" class="btn btn-ghost-light btn-lg">About the Company</a>
            </div>
          </div>
        </div>
      </div>
      <div class="hs-slide">
        <div class="hs-bg"><img src="/img/hero-pipeline.jpg" alt="" decoding="async" /></div>
        <div class="container">
          <div class="hs-inner">
            <span class="hs-kicker">Fuels · Gas · LPG</span>
            <h1>Fuels, Gas &amp; LPG — Delivered Safely</h1>
            <p class="lead">From PMS, AGO and DPK to LPG and natural gas, we keep industry, fleets and homes reliably supplied — safely and on time, nationwide.</p>
            <div class="btn-row">
              <a href="/services" class="btn btn-primary btn-lg">Our Services <Icon name="arrow" /></a>
              <a href="/contact" class="btn btn-ghost-light btn-lg">Request a Quote</a>
            </div>
          </div>
        </div>
      </div>
      <div class="hs-slide">
        <div class="hs-bg"><img src="/img/hero-offshore.jpg" alt="" decoding="async" /></div>
        <div class="container">
          <div class="hs-inner">
            <span class="hs-kicker">Engineering &amp; Energy Services</span>
            <h1>Integrated Energy &amp; Engineering</h1>
            <p class="lead">Haulage and logistics plus specialist engineering, procurement and power solutions — one dependable partner, engineered to standard.</p>
            <div class="btn-row">
              <a href="/services#engineering" class="btn btn-primary btn-lg">Engineering Services <Icon name="arrow" /></a>
              <a href="/contact" class="btn btn-ghost-light btn-lg">Contact Us</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <button class="hs-arrow prev" type="button" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button class="hs-arrow next" type="button" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <div class="hs-dots" aria-label="Choose slide">
      <button class="is-active" type="button" aria-label="Slide 1"></button>
      <button type="button" aria-label="Slide 2"></button>
      <button type="button" aria-label="Slide 3"></button>
    </div>
  </section>

  <!-- ASSURANCE BAR -->
  <section class="hx-assure">
    <div class="container hx-assure-row">
      <span><Icon name="shield-check" /> HSE-led operations</span>
      <span><Icon name="check-circle" /> CAC Registered · RC 1232655</span>
      <span><Icon name="globe" /> Nationwide supply</span>
      <span><Icon name="clock" /> 24/7 availability</span>
    </div>
  </section>

  <!-- INTRO + FACTS -->
  <section class="hx-intro">
    <div class="container hx-intro-grid">
      <div class="hx-intro-lead reveal">
        <span class="hx-eyebrow">Who We Are</span>
        <h2>Reliable energy for Nigeria's homes, businesses and industry.</h2>
        <p>Hydrosyng Oil &amp; Gas Ltd is a wholly indigenous Nigerian energy company, incorporated in 2014. We operate across the downstream petroleum sector and energy services — supplying fuels, gas &amp; LPG, haulage and specialist engineering nationwide.</p>
        <p>Our strength is local knowledge backed by disciplined, standards-driven operations, with safety at the centre of everything we do.</p>
        <a href="/about" class="btn btn-primary">About Hydrosyng <Icon name="arrow" /></a>
      </div>
      <aside class="hx-facts reveal d1">
        <div class="hx-fact"><span>Established</span><strong>{site.incorporated}</strong></div>
        <div class="hx-fact"><span>Registration</span><strong>{site.rc}</strong></div>
        <div class="hx-fact"><span>Head Office</span><strong>EFAB City Estate, Abuja</strong></div>
        <div class="hx-fact"><span>Structure</span><strong>Private Ltd by Shares</strong></div>
      </aside>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="hx-do">
    <div class="container">
      <div class="hx-do-head reveal">
        <span class="hx-eyebrow light">What We Do</span>
        <h2>Four divisions, one dependable partner</h2>
        <p>Value across the downstream chain, backed by a specialist engineering and energy-services arm.</p>
      </div>
      <div class="hx-do-grid">
        <a href="/services#fuels" class="hx-do-item reveal">
          <span class="hx-num">01</span>
          <h3>Fuels &amp; Products</h3>
          <p>PMS, AGO and DPK supply and distribution to industrial, commercial and retail customers.</p>
          <span class="hx-more">Learn more <Icon name="arrow" /></span>
        </a>
        <a href="/services#gas" class="hx-do-item reveal d1">
          <span class="hx-num">02</span>
          <h3>Gas &amp; LPG</h3>
          <p>LPG and natural gas for homes, businesses and industry — cleaner, more affordable energy.</p>
          <span class="hx-more">Learn more <Icon name="arrow" /></span>
        </a>
        <a href="/services#logistics" class="hx-do-item reveal d2">
          <span class="hx-num">03</span>
          <h3>Haulage &amp; Logistics</h3>
          <p>Safe bulk haulage, storage and distribution — moving product where and when it's needed.</p>
          <span class="hx-more">Learn more <Icon name="arrow" /></span>
        </a>
        <a href="/services#engineering" class="hx-do-item reveal d3">
          <span class="hx-num">04</span>
          <h3>Engineering Services</h3>
          <p>Facility construction &amp; maintenance, procurement and power solutions for the energy sector.</p>
          <span class="hx-more">Learn more <Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- WHY / SHOWCASE -->
  <section class="hx-show">
    <div class="container hx-show-grid">
      <div class="hx-show-text reveal">
        <span class="hx-eyebrow">Why Hydrosyng</span>
        <h2>Safety-first, reliable, and genuinely local</h2>
        <p>We combine deep local roots with disciplined standards to create lasting value for our customers and communities.</p>
        <ul class="hx-points">
          <li><span class="hx-mark"></span><div><strong>Safety first</strong><p>A target-zero HSE culture protecting people and the environment at every site.</p></div></li>
          <li><span class="hx-mark"></span><div><strong>Proven reliability</strong><p>Dependable supply and uptime backed by robust logistics and disciplined operations.</p></div></li>
          <li><span class="hx-mark"></span><div><strong>Local content</strong><p>Championing Nigerian talent, suppliers and capacity in line with NCDMB objectives.</p></div></li>
          <li><span class="hx-mark"></span><div><strong>Integrated strength</strong><p>One partner across fuels, gas and engineering — fewer handoffs, better control.</p></div></li>
        </ul>
        <a href="/services" class="btn btn-outline">Explore our services</a>
      </div>
      <div class="hx-show-media reveal d1">
        <img src="/img/about-facility.jpg" alt="Hydrosyng energy facility" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="hx-cta">
    <div class="container hx-cta-inner">
      <div class="hx-cta-text reveal">
        <h2>Let's power your next project</h2>
        <p>Reliable fuel supply, gas &amp; LPG or specialist engineering — our team is ready to help.</p>
      </div>
      <div class="hx-cta-actions reveal d1">
        <a href="/contact" class="btn btn-white btn-lg">Contact our team</a>
        <a href="/services" class="btn btn-ghost-light btn-lg">Browse services</a>
      </div>
    </div>
  </section>
</Base>
