---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';

const roles = [
  { title: 'Depot / Operations Officer', type: 'Full-time', loc: 'Nigeria', area: 'Operations' },
  { title: 'Fuel Truck Driver (Haulage)', type: 'Full-time', loc: 'Nigeria', area: 'Logistics' },
  { title: 'HSE Officer', type: 'Full-time', loc: 'Nigeria', area: 'HSE' },
  { title: 'Sales & Business Development Executive', type: 'Full-time', loc: 'Nigeria', area: 'Commercial' }
];
const faqs = [
  { q: 'How do I apply for a role?', a: 'Send your CV and a short cover note to our email with the role title in the subject line. Our team reviews every application and will contact shortlisted candidates.' },
  { q: 'Do you offer graduate or entry-level opportunities?', a: 'Yes. We welcome motivated graduates and entry-level candidates, particularly in operations, logistics and commercial roles. Tell us about yourself and why you want to join Hydrosyng.' },
  { q: 'What is it like to work at Hydrosyng?', a: 'We are a safety-first, hands-on team that values reliability, integrity and initiative. You will work alongside experienced professionals and take on real responsibility.' },
  { q: 'Do you accept speculative applications?', a: 'Absolutely. If you do not see a role that fits, send us your CV anyway — we keep strong applications on file and reach out when suitable openings arise.' }
];
---
<Base
  title="Careers — Hydrosyng Oil & Gas Ltd"
  description="Build your career with Hydrosyng Oil & Gas Ltd. Explore open roles in operations, logistics, HSE and commercial, and learn what it's like to work with us."
  current="careers"
  path="/careers"
>
  <PageHero
    title="Careers at Hydrosyng"
    subtitle="Join a safety-first, Nigerian energy company where your work makes a real difference."
    image="/img/banner-careers.jpg"
    crumb="Careers"
  />

  <!-- INTRO -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split-media reveal"><img src="/img/careers-1.jpg" alt="The Hydrosyng team at work" /></div>
        <div class="reveal d1">
          <span class="eyebrow">Grow With Us</span>
          <h2>Your career, powered by purpose</h2>
          <p>People are at the heart of Hydrosyng. We are always looking for talented, safety-conscious professionals who take pride in reliable delivery — from the depot and the road to the office and the field.</p>
          <p>Join us and you'll take on real responsibility, learn from experienced colleagues and help power progress across Nigeria.</p>
          <div class="btn-row" style="margin-top:22px">
            <a href={"mailto:" + site.email + "?subject=Career%20Enquiry"} class="btn btn-primary">Send Your CV <Icon name="send" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section bg-tint">
    <div class="container">
      <div class="section-head text-center">
        <span class="eyebrow center">Why Hydrosyng</span>
        <h2>What we offer our people</h2>
      </div>
      <div class="grid grid-3">
        <div class="value-item reveal"><div class="vi-icon"><Icon name="shield" /></div><div><h3>A Safe Workplace</h3><p>Your safety is our first priority, backed by training, procedures and the right equipment.</p></div></div>
        <div class="value-item reveal d1"><div class="vi-icon"><Icon name="gauge" /></div><div><h3>Real Responsibility</h3><p>Meaningful work and the chance to make an impact from day one.</p></div></div>
        <div class="value-item reveal d2"><div class="vi-icon"><Icon name="award" /></div><div><h3>Growth &amp; Development</h3><p>Learn from experienced professionals and grow your skills and career.</p></div></div>
        <div class="value-item reveal"><div class="vi-icon"><Icon name="users" /></div><div><h3>A Supportive Team</h3><p>A collaborative, respectful culture where people look out for one another.</p></div></div>
        <div class="value-item reveal d1"><div class="vi-icon"><Icon name="handshake" /></div><div><h3>Fair &amp; Inclusive</h3><p>Equal opportunity and merit-based hiring for all candidates.</p></div></div>
        <div class="value-item reveal d2"><div class="vi-icon"><Icon name="globe" /></div><div><h3>Local Impact</h3><p>Be part of a company creating value and jobs in Nigeria.</p></div></div>
      </div>
    </div>
  </section>

  <!-- OPEN ROLES -->
  <section class="section">
    <div class="container">
      <div class="section-head text-center">
        <span class="eyebrow center">Open Roles</span>
        <h2>Current opportunities</h2>
        <p>Don't see the right role? Send us your CV anyway — we're always keen to meet good people.</p>
      </div>
      <div class="grid" style="gap:16px">
        {roles.map((r) => (
          <div class="job reveal">
            <div>
              <h3>{r.title}</h3>
              <div class="job-meta">
                <span><Icon name="briefcase" />{r.area}</span>
                <span><Icon name="clock" />{r.type}</span>
                <span><Icon name="pin" />{r.loc}</span>
              </div>
            </div>
            <a class="btn btn-outline" href={"mailto:" + site.email + "?subject=Application%20-%20" + encodeURIComponent(r.title)}>Apply</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-tint">
    <div class="container container-narrow">
      <div class="section-head text-center">
        <span class="eyebrow center">Questions</span>
        <h2>Careers FAQ</h2>
      </div>
      <div class="accordion" data-single>
        {faqs.map((f) => (
          <div class="acc-item">
            <button class="acc-head" type="button">{f.q}<span class="ico">+</span></button>
            <div class="acc-body"><div class="acc-body-inner">{f.a}</div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="cta-band reveal">
        <h2>Ready to join us?</h2>
        <p>Send your CV and tell us how you'd like to contribute to Hydrosyng.</p>
        <div class="btn-row center">
          <a href={"mailto:" + site.email + "?subject=Career%20Enquiry"} class="btn btn-white btn-lg">Email Your CV</a>
          <a href="/contact" class="btn btn-ghost-light btn-lg">Contact HR</a>
        </div>
      </div>
    </div>
  </section>
</Base>
