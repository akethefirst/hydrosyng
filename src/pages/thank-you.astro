---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Thank You — Hydrosyng Oil & Gas Ltd" description="Thank you for contacting Hydrosyng Oil & Gas Ltd." path="/thank-you">
  <section class="section">
    <div class="container container-narrow text-center">
      <div class="feature-icon" style="width:80px;height:80px;margin:0 auto 24px;background:var(--grad-accent);color:#fff"><Icon name="check" /></div>
      <span class="eyebrow center">Message Received</span>
      <h1>Thank you for reaching out</h1>
      <p class="lead" style="margin:16px auto 30px;max-width:560px">We've received your enquiry and a member of the Hydrosyng team will get back to you shortly.</p>
      <div class="btn-row center">
        <a href="/" class="btn btn-primary btn-lg">Back to Home</a>
        <a href="/services" class="btn btn-outline btn-lg">Explore Services</a>
      </div>
    </div>
  </section>
</Base>
